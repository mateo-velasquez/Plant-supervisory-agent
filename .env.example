# Copy to .env and fill in. Never commit .env.
# System environment variables take precedence over .env (that is how CI injects secrets).

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=

# --- Model ---
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=medium

# --- Paths ---
DATA_DIR=data
OUTPUT_DIR=outputs

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO

# --- Held-out days: product guard (FR-40), not the dev hook CLAUDE_ALLOW_HELDOUT ---
HELDOUT_OPEN=false
HELDOUT_FIRST_SHIFT=T22
