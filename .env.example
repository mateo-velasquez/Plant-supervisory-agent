# Copiar a .env y completar. .env nunca se commitea.
# Las variables del sistema tienen prioridad sobre .env (así se inyectan los secretos en CI).

# --- Anthropic (obligatoria) ---
ANTHROPIC_API_KEY=

# --- Modelo ---
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=medium

# --- Rutas ---
DATA_DIR=data
OUTPUT_DIR=outputs

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
