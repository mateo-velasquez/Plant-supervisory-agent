# Copy to .env and fill in. Never commit .env.
# System environment variables take precedence over .env (that is how CI injects secrets).

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=

# --- Model ---
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=medium

# --- Paths ---
DATA_DIR=data
OUTPUT_DIR=outputs

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO

# --- Held-out days: product guard (FR-40), not the dev hook CLAUDE_ALLOW_HELDOUT ---
HELDOUT_OPEN=false
HELDOUT_FIRST_SHIFT=T22

# --- Size budgets in characters (006 R12); must be > 0 ---
TOOL_OUTPUT_MAX_CHARS=4000
LOGBOOK_MAX_CHARS=4000

# --- Anthropic call limits and retries (007 R16) ---
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_MAX_RETRIES=4
ANTHROPIC_RETRY_BASE_SECONDS=1.0
ANTHROPIC_RETRY_CAP_SECONDS=30.0

# --- Agent loop (007 R16); PROMPT_TOKEN_LIMIT must be 1-100000 ---
PROMPT_TOKEN_LIMIT=95000
AGENT_MAX_TURNS=8
NOTICE_TEXT_MAX_CHARS=1500

# --- Multi-agent (009 R15); each must be >= 1 ---
INVESTIGATOR_MAX_TURNS=4
PROPOSAL_OUTPUT_MAX_CHARS=2000
LOGBOOK_REVIEW_MAX_ATTEMPTS=2

# --- Prices in USD per million tokens (007 R16) ---
PRICE_INPUT_PER_MTOK=0.10
PRICE_CACHE_WRITE_5M_PER_MTOK=0.125
PRICE_CACHE_WRITE_1H_PER_MTOK=0.20
PRICE_CACHE_READ_PER_MTOK=0.01
PRICE_OUTPUT_PER_MTOK=0.50
LONG_CONTEXT_THRESHOLD_TOKENS=100000
LONG_CONTEXT_MULTIPLIER=5
